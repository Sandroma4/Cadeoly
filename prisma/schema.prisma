generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@wishi/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  recipients Recipient[]
  id             String              @id @default(cuid())
  name           String?
  email          String?             @unique
  emailVerified  DateTime?
  image          String?
  locale         String?             @default("fr")
  password       String? // Hashed password
  guestTokenHash String? @unique
  guestExpiresAt DateTime?
  sessionVersion Int                 @default(0)
  tutorialCompletedAt DateTime?
  emailRemindersEnabled Boolean     @default(false)
  emailReminderDays Int              @default(3)
  reminderDeliveries ReminderDelivery[]
  giftBudgets GiftBudget[]
  favorites GiftFavorite[]
  passwordReset  PasswordResetToken?

  accounts Account[]
  sessions Session[]

  // Relations métier
  ownedFamilies Family[]       @relation("FamilyOwner")
  familyMembers FamilyMember[]
  wishlists     Wishlist[]
  reservations  Reservation[]
  contributions Contribution[]
  feedback      Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GiftBudget {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope String @default("ALL")
  currency String
  amountCents Int
  updatedAt DateTime @updatedAt
  @@unique([userId, scope, currency])
}

model ReminderDelivery {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseUntil DateTime
  sentAt DateTime?
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model AuthRequestThrottle {
  key         String   @id
  windowStart DateTime
  attempts    Int      @default(0)
}

// ------------------------------------------------------
// BUSINESS LOGIC
// ------------------------------------------------------

model Family {
  membershipVersion Int     @default(0)
  id                String  @id @default(cuid())
  name              String
  description       String?
  image             String?

  ownerId String
  owner   User   @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members     FamilyMember[]
  events      Event[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FamilyMember {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  role String @default("MEMBER") // ENUM: ADMIN, MEMBER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, familyId])
  @@index([familyId])
}

model Invitation {
  id       String @id @default(cuid())
  email    String
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  token   String   @unique
  expires DateTime

  createdAt DateTime @default(now())

  @@index([familyId, email])
}

model Wishlist {
  recipientId String?
  recipient Recipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  occasion    String?
  neededBy    String?
  preferences String?
  archivedAt  DateTime?
  deletedAt   DateTime?
  id          String    @id @default(cuid())
  name        String
  description String?
  image       String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  visibility String  @default("FAMILY") // ENUM: PRIVATE, FAMILY, LINK, PUBLIC
  shareToken String? @unique

  items   WishlistItem[]
  eventId String?
  event   Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, visibility])
  @@index([eventId])
}

model WishlistItem {
  position Int @default(0)
  favorites GiftFavorite[]
  alternativeUrls String @default("")
  isGroupGift   Boolean        @default(false)
  contributions Contribution[]
  deletedAt     DateTime?
  id            String         @id @default(cuid())
  title         String
  description   String?
  url           String?
  priceCents    Int?
  currency      String?        @default("EUR")
  image         String?

  categoryId String?
  size       String?
  color      String?
  model      String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  priority String @default("NORMAL") // ENUM: LOW, NORMAL, HIGH, ESSENTIAL

  quantityDesired Int @default(1)

  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wishlistId])
  @@index([wishlistId, deletedAt])
}

model Recipient {
  id String @id @default(cuid())
  name String
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  wishlists Wishlist[]
  @@index([ownerId])
}

model Reservation {
  guestFirstName String?
  guestEmail String?
  guestSessionHash String?
  personalMessage String?
  messageReleasedAt DateTime?
  managementTokenHash String? @unique
  managementExpiresAt DateTime?
  recapSentAt DateTime?
  preparationStatus String @default("RESERVED")
  accessTokenHash String?
  id              String  @id @default(cuid())
  quantity        Int     @default(1)

  itemId String       @unique
  item   WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Contribution {
  id              String       @id @default(cuid())
  itemId          String
  item            WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int
  accessTokenHash String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([itemId, userId])
  @@index([userId])
}

model GiftFavorite {
  id String @id @default(cuid())
  userId String
  itemId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([userId, itemId])
  @@index([itemId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Category {
  id    String  @id @default(cuid())
  name  String  @unique
  color String?

  items WishlistItem[]
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  wishlists Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, date])
}

{
  "name": "cadeoly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/hosted-start.cjs",
    "lint": "eslint",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.cjs",
    "db:seed": "node scripts/seed.cjs",
    "backup:create": "node --env-file-if-exists=.env scripts/backup.cjs create",
    "backup:verify": "node --env-file-if-exists=.env scripts/backup.cjs verify",
    "backup:restore": "node --env-file-if-exists=.env scripts/backup.cjs restore",
    "backup:daily": "node --env-file-if-exists=.env scripts/daily-backup.cjs",
    "email:check": "node --env-file-if-exists=.env scripts/check-email.cjs",
    "email:setup:gmail": "node --env-file-if-exists=.env scripts/setup-gmail.cjs",
    "launch:check": "node --env-file-if-exists=.env scripts/launch-check.cjs",
    "format": "prettier --write src messages tests scripts prisma/seed.ts next.config.ts eslint.config.mjs --ignore-path .gitignore",
    "backup:package": "node scripts/package-backup.cjs",
    "email:status": "node --env-file-if-exists=.env scripts/email-status.cjs",
    "feedback:list": "node --env-file-if-exists=.env scripts/feedback.cjs list"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "3.6.2",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@swc/core": "1.16.2"
  }
}
